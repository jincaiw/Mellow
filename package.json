{
  "name": "mellow",
  "private": true,
  "version": "0.1.0",
  "description": "Mellow — Typora 级跨平台 Markdown 编辑器（monorepo，pnpm workspace）",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=4 run build",
    "test": "pnpm -r --workspace-concurrency=4 run test",
    "typecheck": "pnpm -r --workspace-concurrency=4 run build",
    "desktop:dev": "pnpm --filter mellow-desktop dev",
    "desktop:build": "pnpm --filter mellow-desktop build",
    "desktop:tauri": "pnpm --filter mellow-desktop tauri",
    "rust:test": "cd apps/desktop/src-tauri && cargo test"
  }
}
